# Your DNS A record MUST point at this server's public IP for automatic HTTPS.
SITE_DOMAIN=roomie.example.com
# Public Google OAuth 2.0 WEB Client ID (client ID, not client secret).
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Generate using: openssl rand -hex 32. Do not commit actual secret.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
